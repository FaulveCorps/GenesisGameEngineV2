{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Ninja, Debug, Auto vcpkg)",
      "description": "Configure with Ninja generator, Debug build, and automatic vcpkg dependency resolution",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "release",
      "displayName": "Release (Ninja, Release, Auto vcpkg)",
      "description": "Configure with Ninja generator, Release build, and automatic vcpkg dependency resolution",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "binaryDir": "${sourceDir}/build-release"
    },
    {
      "name": "vs2022-debug",
      "displayName": "Visual Studio 2022 (Debug, Auto vcpkg)",
      "description": "Configure with Visual Studio 17 2022 generator and automatic vcpkg integration",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "binaryDir": "${sourceDir}/build-vs"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug (All Targets)",
      "description": "Build all targets in Debug configuration",
      "configurePreset": "default",
      "jobs": 0,
      "configuration": "Debug"
    },
    {
      "name": "debug-engine",
      "displayName": "Build Engine Core (Debug)",
      "description": "Build EngineCore library only (Debug)",
      "configurePreset": "default",
      "targets": ["EngineCore"],
      "configuration": "Debug"
    },
    {
      "name": "debug-sample",
      "displayName": "Build Sample Game (Debug)",
      "description": "Build SampleGame executable (Debug)",
      "configurePreset": "default",
      "targets": ["SampleGame"],
      "configuration": "Debug"
    },
    {
      "name": "debug-tests",
      "displayName": "Build Tests (Debug)",
      "description": "Build UnitTests executable (Debug)",
      "configurePreset": "default",
      "targets": ["UnitTests"],
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build Release (All Targets)",
      "description": "Build all targets in Release configuration",
      "configurePreset": "release",
      "jobs": 0,
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "Run Tests (Debug)",
      "description": "Run unit tests from Debug build",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false
      }
    }
  ]
}
